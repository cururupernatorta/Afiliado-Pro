{
  "name": "afiliado-pro",
  "version": "1.4.3",
  "description": "Bot de automacao para afiliados - WhatsApp, Telegram, Scraping e Links de Afiliado",
  "main": "dist-electron/main/main.js",
  "author": "Afiliado Pro",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:renderer dev:electron",
    "dev:renderer": "vite",
    "dev:electron": "electron-vite dev",
    "build": "npm-run-all clean build:renderer build:electron",
    "clean": "rimraf dist dist-electron release",
    "build:renderer": "tsc && vite build",
    "build:electron": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "rebuild": "npx @electron/rebuild"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@whiskeysockets/baileys": "^6.7.16",
    "axios": "^1.8.4",
    "better-sqlite3": "^12.1.0",
    "bullmq": "^5.49.2",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.0",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.7.4",
    "ioredis": "^5.6.1",
    "lucide-react": "^0.487.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "sharp": "^0.34.1",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.4",
    "telegram": "^2.26.22",
    "tw-animate-css": "^1.2.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@tailwindcss/vite": "^4.1.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.14.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  },
  "build": {
    "appId": "com.afiliadopro.app",
    "productName": "Afiliado Pro",
    "copyright": "Copyright 2026 Afiliado Pro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "migrations/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@whiskeysockets/baileys/**/*",
      "node_modules/telegram/**/*",
      "node_modules/libsignal/**/*",
      "node_modules/bufferutil/**/*",
      "node_modules/utf-8-validate/**/*",
      "node_modules/axios/**/*",
      "node_modules/cheerio/**/*",
      "node_modules/bullmq/**/*",
      "node_modules/ioredis/**/*",
      "node_modules/pino/**/*",
      "node_modules/pino-pretty/**/*",
      "node_modules/qrcode/**/*",
      "dist-electron/main/**/*.node",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "migrations",
        "to": "migrations"
      }
    ],
    "npmRebuild": true,
    "buildDependenciesFromSource": true,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Afiliado Pro",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "cururupernatorta",
      "repo": "Afiliado-Pro",
      "releaseType": "release"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "icon": "assets/icon.png"
    }
  }
}
